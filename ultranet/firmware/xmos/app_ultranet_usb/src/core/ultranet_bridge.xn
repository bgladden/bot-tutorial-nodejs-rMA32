<?xml version="1.0" encoding="UTF-8"?>
<!--
  Port map for the Ultranet USB bridge.
  Package/oscillator below match a generic XU316 (TQ128) board.  Adjust the
  <Package>/<Node> lines and the port locations to the board you actually use
  (the X?D pin behind each XS1_PORT_1x is in the XU316 datasheet).
  All I2S ports are on tile 1, MCLK goes to BOTH tiles (USB tile counts it).
-->
<Network xmlns="http://www.xmos.com"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://www.xmos.com http://www.xmos.com">
  <Type>Board</Type>
  <Name>Ultranet USB Bridge</Name>

  <Declarations>
    <Declaration>tileref tile[2]</Declaration>
  </Declarations>

  <Packages>
    <Package id="0" Type="XS3-UnA-1024-TQ128">
      <Nodes>
        <Node Id="0" InPackageId="0" Type="XS3-L16A-1024" Oscillator="24MHz" SystemFrequency="600MHz" ReferenceFrequency="100MHz">
          <Boot>
            <Source Location="bootFlash"/>
          </Boot>
          <Tile Number="0" Reference="tile[0]">
            <Port Location="XS1_PORT_1B"  Name="PORT_SQI_CS"/>
            <Port Location="XS1_PORT_1C"  Name="PORT_SQI_SCLK"/>
            <Port Location="XS1_PORT_4B"  Name="PORT_SQI_SIO"/>
            <!-- MCLK from RP2350 GP12 (also wired to tile 1 PORT_1D) -->
            <Port Location="XS1_PORT_1D"  Name="PORT_MCLK_IN_USB"/>
            <Port Location="XS1_PORT_16B" Name="PORT_MCLK_COUNT"/>
          </Tile>
          <Tile Number="1" Reference="tile[1]">
            <Port Location="XS1_PORT_1D"  Name="PORT_MCLK_IN"/>      <!-- RP2350 GP12 -->
            <Port Location="XS1_PORT_16B" Name="PORT_MCLK_COUNT_2"/>
            <Port Location="XS1_PORT_1B"  Name="PORT_I2S_LRCLK"/>    <!-- RP2350 GP10 -->
            <Port Location="XS1_PORT_1C"  Name="PORT_I2S_BCLK"/>     <!-- RP2350 GP11 -->
            <Port Location="XS1_PORT_1I"  Name="PORT_I2S_ADC0"/>     <!-- GP2: ch 1/2   -->
            <Port Location="XS1_PORT_1J"  Name="PORT_I2S_ADC1"/>     <!-- GP3: ch 3/4   -->
            <Port Location="XS1_PORT_1K"  Name="PORT_I2S_ADC2"/>     <!-- GP4: ch 5/6   -->
            <Port Location="XS1_PORT_1L"  Name="PORT_I2S_ADC3"/>     <!-- GP5: ch 7/8   -->
            <Port Location="XS1_PORT_1M"  Name="PORT_I2S_ADC4"/>     <!-- GP6: ch 9/10  -->
            <Port Location="XS1_PORT_1N"  Name="PORT_I2S_ADC5"/>     <!-- GP7: ch 11/12 -->
            <Port Location="XS1_PORT_1O"  Name="PORT_I2S_ADC6"/>     <!-- GP8: ch 13/14 -->
            <Port Location="XS1_PORT_1P"  Name="PORT_I2S_ADC7"/>     <!-- GP9: ch 15/16 -->
          </Tile>
        </Node>
      </Nodes>
    </Package>
  </Packages>

  <ExternalDevices>
    <Device NodeId="0" Tile="0" Class="SQIFlash" Name="bootFlash" PageSize="256" SectorSize="4096" NumPages="16384">
      <Attribute Name="PORT_SQI_CS"   Value="PORT_SQI_CS"/>
      <Attribute Name="PORT_SQI_SCLK" Value="PORT_SQI_SCLK"/>
      <Attribute Name="PORT_SQI_SIO"  Value="PORT_SQI_SIO"/>
    </Device>
  </ExternalDevices>

  <JTAGChain>
    <JTAGDevice NodeId="0"/>
  </JTAGChain>
</Network>
